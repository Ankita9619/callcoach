# Copy to .env and adjust. Every value is optional: the defaults run in mock mode on SQLite.

# SQLite (default) or PostgreSQL:
# DATABASE_URL=postgresql+psycopg://callcoach:callcoach@localhost:5432/callcoach
DATABASE_URL=sqlite:///./callcoach.db

# mock | anthropic | openai
LLM_PROVIDER=mock
# LLM_MODEL=            # optional, overrides the provider's default model
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

SEED_SAMPLE_DATA=true
